{{- /* Atom feed, same shape as jekyll-feed. Args: page, pages, title, self (path). */ -}}
{{- $pages := first site.Params.feed_limit .pages -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://gohugo.io/" version="{{ hugo.Version }}">Hugo</generator>
  <link href="{{ .self | absURL }}" rel="self" type="application/atom+xml" />
  <link href="{{ "/" | absURL }}" rel="alternate" type="text/html" />
  <updated>{{ (index $pages 0).Date.Format "2006-01-02T15:04:05-07:00" }}</updated>
  <id>{{ .self | absURL }}</id>
  <title type="html">{{ .title }}</title>
  <subtitle>{{ site.Params.description }}</subtitle>
  <author><name>{{ site.Params.author }}</name></author>
  {{- range $pages }}
  <entry>
    <title type="html">{{ .Title }}</title>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html" title="{{ .Title }}" />
    <published>{{ .Date.Format "2006-01-02T15:04:05-07:00" }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</updated>
    <id>{{ .Permalink }}</id>
    <content type="html" xml:base="{{ .Permalink }}">{{ .Content | html }}</content>
    <author><name>{{ .Params.author | default site.Params.author }}</name></author>
    {{- with .Params.category }}
    <category term="{{ . }}" />
    {{- end }}
    {{- range .Params.tags }}
    <category term="{{ . }}" />
    {{- end }}
    <summary type="html">{{ .Summary | html }}</summary>
  </entry>
  {{- end }}
</feed>
